rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCreator() {
      return signedIn() && request.auth.uid == 'joCInK8h1odw5hnknvtNk8gOeoC2';
    }

    function isAdministrator() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['creator', 'admin'];
    }

    function canModerateChat() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['creator', 'admin', 'moderator'];
    }

    function isChatMuted(userId) {
      return exists(/databases/$(database)/documents/chatMutes/$(userId))
        && get(/databases/$(database)/documents/chatMutes/$(userId)).data.mutedUntil > request.time;
    }

    function validNickname(nickname) {
      return nickname is string && nickname.size() >= 2 && nickname.size() <= 24;
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'nickname', 'activeSeconds', 'createdAt', 'updatedAt', 'role',
          'online', 'lastSeen', 'lastActivityAt'
        ])
        && request.resource.data.keys().hasOnly([
          'nickname', 'activeSeconds', 'createdAt', 'updatedAt', 'role',
          'online', 'lastSeen', 'lastActivityAt'
        ])
        && validNickname(request.resource.data.nickname)
        && request.resource.data.activeSeconds == 0
        && request.resource.data.role == (userId == 'joCInK8h1odw5hnknvtNk8gOeoC2' ? 'creator' : 'member')
        && request.resource.data.online == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSeen == request.time
        && request.resource.data.lastActivityAt == request.time;

      allow update: if signedIn()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'nickname', 'activeSeconds', 'updatedAt', 'role',
              'online', 'lastSeen', 'lastActivityAt'
            ])
            && validNickname(request.resource.data.nickname)
            && request.resource.data.role in ['member', 'moderator', 'admin', 'creator']
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
              || request.resource.data.role == resource.data.get(
                'role',
                userId == 'joCInK8h1odw5hnknvtNk8gOeoC2' ? 'creator' : 'member'
              )
              || (
                userId == 'joCInK8h1odw5hnknvtNk8gOeoC2'
                && request.resource.data.role == 'creator'
              )
            )
            && request.resource.data.activeSeconds is int
            && request.resource.data.activeSeconds >= resource.data.get('activeSeconds', 0)
            && request.resource.data.activeSeconds <= resource.data.get('activeSeconds', 0) + 60
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeSeconds'])
              || (
                request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
                && request.resource.data.updatedAt == request.time
                && request.resource.data.activeSeconds - resource.data.get('activeSeconds', 0)
                  <= ((request.time.toMillis() - resource.data.get('updatedAt', request.time).toMillis()) / 1000) + 5
              )
            )
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
              || request.resource.data.updatedAt == request.time
            )
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['online'])
              || request.resource.data.online is bool
            )
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeen'])
              || request.resource.data.lastSeen == request.time
            )
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastActivityAt'])
              || request.resource.data.lastActivityAt == request.time
            )
          )
          || (
            isCreator()
            && userId != 'joCInK8h1odw5hnknvtNk8gOeoC2'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
            && request.resource.data.role in ['member', 'moderator', 'admin']
            && request.resource.data.updatedAt == request.time
          )
        );
    }

    match /homework/{homeworkId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'subject', 'title', 'dueDate', 'createdAt', 'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'subject', 'title', 'dueDate', 'createdAt', 'createdBy'
        ])
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;

      allow delete: if isAdministrator();
    }

    match /chatMessages/{messageId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && !isChatMuted(request.auth.uid)
        && request.resource.data.keys().hasAll(['uid', 'nickname', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.nickname
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if signedIn()
        && (
          resource.data.uid == request.auth.uid
          || (
            canModerateChat()
            && resource.data.uid != request.auth.uid
            && resource.data.uid != 'joCInK8h1odw5hnknvtNk8gOeoC2'
          )
        );
    }

    match /chatMutes/{userId} {
      allow read: if signedIn();

      allow create, update: if canModerateChat()
        && userId != request.auth.uid
        && userId != 'joCInK8h1odw5hnknvtNk8gOeoC2'
        && exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.keys().hasAll(['uid', 'nickname', 'mutedUntil', 'mutedBy', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'mutedUntil', 'mutedBy', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.nickname
          == get(/databases/$(database)/documents/users/$(userId)).data.nickname
        && request.resource.data.mutedBy == request.auth.uid
        && request.resource.data.mutedUntil is timestamp
        && request.resource.data.mutedUntil > request.time
        && request.resource.data.mutedUntil <= request.time + duration.value(7, 'd')
        && request.resource.data.updatedAt == request.time;

      allow delete: if canModerateChat()
        && userId != request.auth.uid
        && userId != 'joCInK8h1odw5hnknvtNk8gOeoC2';
    }

    match /chatTyping/{userId} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && !isChatMuted(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.keys().hasAll(['uid', 'nickname', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'expiresAt'])
        && request.resource.data.uid == userId
        && request.resource.data.nickname
          == get(/databases/$(database)/documents/users/$(userId)).data.nickname
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(15, 's');

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /siteFeedback/{feedbackId} {
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['type', 'message', 'uid', 'nickname', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'message', 'uid', 'nickname', 'createdAt'])
        && request.resource.data.type in ['suggestion', 'complaint']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname
        && request.resource.data.createdAt == request.time;

      allow read: if isAdministrator();
      allow update: if false;
      allow delete: if isAdministrator();
    }
  }
}
